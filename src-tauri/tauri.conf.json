{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ankigen",
  "version": "1.1.0",
  "identifier": "ankiesh",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://127.0.0.1:5000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Ankigen",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/*": "./"
    },
    "externalBin": ["binaries/flask-server"]
  }
}
