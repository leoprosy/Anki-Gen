            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "track": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "pattern": "^-?[0-9]{1,5}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "precision": {
            "type": "string",
            "enum": [
              "day",
              "month",
              "year",
              "decade",
              "century",
