{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ankigen.timeline/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ankigen.timeline/1"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "subtitle": {
      "type": "string",
      "maxLength": 200
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tracks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "eras": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "start": {
            "type": "string",
            "pattern": "^-?[0-9]{1,5}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "end": {
            "type": "string",
            "pattern": "^(-?[0-9]{1,5}(-[0-9]{2}(-[0-9]{2})?)?|present)$"
          },
          "precision": {
            "type": "string",
            "enum": [
              "day",
              "month",
              "year",
              "decade",
              "century",
              "millennium"
            ]
          },
          "approx": {
            "type": "boolean"
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "origin": {
            "type": "string",
            "enum": [
              "text",
              "model"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "date_text": {
            "type": "string",
            "maxLength": 80
          },
          "source_quote": {
            "type": "string",
            "maxLength": 240
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 30
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "periods": {
      "type": "array",
      "maxItems": 200,
      "items": {
